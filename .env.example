# MOCK never calls a remote AI service. REAL requires explicit owner approval.
FACTORY_MODE=MOCK
FACTORY_DATA_DIR=data/local
WORKER_BASE_URL=http://127.0.0.1:8765
WORKER_BEARER_TOKEN=factory-local-fake-token
FACTORY_TELEGRAM_TOKEN=
FACTORY_ADMIN_USER_IDS=
FACTORY_ALLOW_PAID_CALLS=false
FACTORY_BATCH_BUDGET=0
FACTORY_ATTEMPT_CAP=0
FACTORY_MAX_RETRIES=3
# Optional absolute paths to a full FFmpeg build, otherwise .tools then PATH.
FACTORY_FFMPEG=
FACTORY_FFPROBE=
